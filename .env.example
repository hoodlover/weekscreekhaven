# Choose a strong owner-only password for /admin.html
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Generate at least 32 random characters. Changing this signs everyone out and makes old invite records unreadable.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Existing public Vercel Blob store used by this project. Invite records are encrypted before upload.
BLOB_READ_WRITE_TOKEN=

# Optional: use a separate private Blob store instead.
# INVITE_BLOB_READ_WRITE_TOKEN=
# INVITE_BLOB_ACCESS=private

# Transactional email delivery through Resend. Verify weekscreekhaven.com in
# Resend first; RESEND_FROM_EMAIL must use that verified domain. Replies go to
# RESEND_REPLY_TO when set, otherwise OWNER_EMAIL.
RESEND_API_KEY=
RESEND_FROM_EMAIL=stay@weekscreekhaven.com
RESEND_FROM_NAME=Weeks Creek Haven
RESEND_REPLY_TO=

# Temporary fallback while Resend domain verification is being completed.
# These can be removed from Vercel after a successful Resend test.
SENDER_API_TOKEN=
SENDER_FROM_EMAIL=
SENDER_FROM_NAME=Weeks Creek Haven
OWNER_EMAIL=

# Square-hosted checkout. Use sandbox until the complete flow has been tested.
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=

# Optional but recommended: Square webhook for instant payment updates.
# In Square Developer Console, subscribe this exact URL to invoice.payment_made and invoice.updated.
SQUARE_WEBHOOK_URL=https://www.weekscreekhaven.com/api/square-webhook
SQUARE_WEBHOOK_SIGNATURE_KEY=
