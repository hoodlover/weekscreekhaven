{
  "rewrites": [
    {
      "source": "/calendar/availability.ics",
      "destination": "/api/channel-calendar-feed"
    }
  ],
  "crons": [
    {
      "path": "/api/admin-calendar-sync",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/email-scheduler",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cleaner-lock-scheduler",
      "schedule": "*/5 * * * *"
    }
  ],
  "redirects": [
    {
      "source": "/availability.html",
      "destination": "/register.html",
      "permanent": false
    }
  ]
}
